# ==========================================
# 1. CORE & SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_SHUTDOWN_TIMEOUT_MS=15000
API_TRUST_PROXY_HOPS=1
API_BODY_LIMIT_BYTES=1048576

# CORS: Production mein sirf apni domain add karein
API_CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173

# ==========================================
# 2. DATABASE (PostgreSQL) - CRITICAL
# ==========================================
# ️ IMPORTANT: 'YOUR_ACTUAL_PASSWORD' ko apne real DB password se replace karein
# Agar local PG install nahi hai, toh Docker ya Supabase/Neon use karein
DATABASE_URL=postgres://mana_ai:YOUR_ACTUAL_PASSWORD@localhost:5432/mana_ai
DATABASE_SSL=disable
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# ==========================================
# 3. AUTHENTICATION & SECURITY
# ==========================================
# JWT Secret: Kam se kam 32 chars ka strong random string hona chahiye

LOCAL_JWT_SECRET=x9#mK2$vL5pQ8wR3jN6yT1bH4cF7dG0aS9eZ2xW5vU8tR3qP6oI1nM41K7jH0gF3dS2a

# Admin Access: Local dev ke liye yeh ID use karein
ADMIN_SUBJECTS=mana-ai-local-development-user

# OIDC (Production ke liye configure karein)
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=

# ==========================================
# 4. AI PROVIDER CONFIGURATION
# ==========================================
# Provider: openai, anthropic, gemini, groq, ollama, etc.
AI_PROVIDER=openai
AI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
AI_MODEL=gpt-4o-mini
AI_ALLOWED_MODELS=gpt-4o-mini,gpt-4o
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=3

# Image Generation
IMAGE_API_KEY=sk-proj-YOUR_IMAGE_API_KEY_HERE
IMAGE_MODEL=dall-e-3
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_TIMEOUT_MS=180000

# ==========================================
# 5. CHAT & RATE LIMITING
# ==========================================
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_MAX_INPUT_MESSAGES=100
CHAT_MAX_MESSAGE_CHARACTERS=20000
CHAT_MAX_RESPONSE_BYTES=1048576

# ==========================================
# 6. LOGGING & OBSERVABILITY
# ==========================================
LOG_LEVEL=debug

# Optional runtime modules. Provider integrations remain disabled until
# complete credentials are supplied; never place real credentials in this file.
APP_REGION=local
APP_REGIONS=local
CDN_BASE_URL=
CDN_CACHE_CONTROL=public, max-age=3600
HELMET_CSP_ENABLED=true
HELMET_HSTS_MAX_AGE_SECONDS=31536000
PUSH_PROVIDER=disabled
SEARCH_ENABLED=true
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_MAX_RESULTS=25
SEARCH_TIMEOUT_MS=5000
SMS_PROVIDER=disabled
SWAGGER_ENABLED=false
SWAGGER_PATH=/docs
VECTOR_DB_ENABLED=false
VECTOR_DB_DIMENSIONS=1536
VECTOR_DB_TABLE=ai_document_chunks
WEBSOCKET_ENABLED=false
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_HEARTBEAT_MS=30000
WEBSOCKET_MESSAGE_MAX_BYTES=1048576
