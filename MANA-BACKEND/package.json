{
  "name": "@mana-ai/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
  "dev": "node --env-file=.env --import tsx --watch src/server.ts",
  "migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
  "seed": "node --env-file=.env --import tsx src/db/seed.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node dist/server.js",
  "lint": "eslint src test",
  "typecheck": "tsc --noEmit -p tsconfig.json",
  "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  }
}
