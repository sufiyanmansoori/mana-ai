# Local Compose template only. Replace the password with a private,
# development-only value. Never use this as a production secrets manager.
NODE_ENV=development
POSTGRES_PASSWORD=replace-with-a-local-development-password
LOCAL_JWT_SECRET=replace-with-at-least-32-random-characters
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_ALLOWED_MODELS=gpt-4o-mini
API_PORT=3000
API_HOST=127.0.0.1
LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DATABASE_URL=postgresql://mana:replace-with-local-password@postgres:5432/mana_ai
DATABASE_SSL=disable
REDIS_URL=redis://redis:6379
ADMIN_PORT=8080
VITE_API_BASE_URL=http://localhost:3000