NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
API_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DATABASE_URL=postgres://mana_ai:change-this-local-password@localhost:5432/mana_ai
DATABASE_SSL=disable
LOCAL_JWT_SECRET=replace-with-at-least-32-random-characters
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_ALLOWED_MODELS=gpt-4o-mini
AI_TIMEOUT_MS=90000
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_MAX_INPUT_MESSAGES=100
CHAT_MAX_MESSAGE_CHARACTERS=20000
CHAT_MAX_RESPONSE_BYTES=1048576
LOG_LEVEL=info
